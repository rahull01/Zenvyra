# =======================================================
# Production .env template (single file for docker-compose)
# =======================================================

############################
# Backend
############################
SPRING_PROFILES_ACTIVE=prod
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
REDIS_URL=redis://:<password>@<host>:6379
MONGO_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
JWT_SECRET=replace-with-64-char-random-secret
APP_AUTH_COOKIES_SECURE=true
APP_BACKUP_ENABLED=false
APP_BACKUP_PROVIDER=
APP_BACKUP_LAST_RESTORE_DRILL_AT=
APP_OPS_ALERT_EMAIL=ops@example.com
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
PAYMENT_API_KEY=
WEBHOOK_SECRET=
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASS=re_...
RESEND_API_KEY=re_...

# Active payment provider (Dodo)
DODO_API_KEY=dp_live_...
DODO_WEBHOOK_SECRET=whsec_...
DODO_BASE_URL=https://api.dodopayments.com
DODO_GROWTH_PRODUCT_ID=prod_growth_id
DODO_PRO_PRODUCT_ID=prod_pro_id
DODO_AGENCY_PRODUCT_ID=prod_agency_id
DODO_SETUP_PACKAGE_PRODUCT_ID=prod_setup_package_id

# Optional Stripe placeholders
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

############################
# Frontend
############################
Zenvyra_REQUIRE_PROD_ENV=true
NEXT_PUBLIC_API_URL=https://api.zenvyra.com/api
NEXT_PUBLIC_APP_URL=https://app.zenvyra.com
NEXT_PUBLIC_WS_URL=wss://api.zenvyra.com/api/ws
API_BASE_URL=http://backend:8080/api
POLICY_FRAME_ANCESTORS='self' https://app.zenvyra.com

# Public payment config
NEXT_PUBLIC_DODO_CLIENT_ID=dodo_client_live_...
NEXT_PUBLIC_DODO_ENV=live
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

############################
# Domain / CORS / URLs
############################
APP_URL=https://app.zenvyra.com
FRONTEND_URL=https://app.zenvyra.com
BACKEND_URL=https://api.zenvyra.com
CORS_ALLOWED_ORIGINS=https://app.zenvyra.com,https://www.zenvyra.com
PAYMENT_WEBHOOK_URL=https://api.zenvyra.com/api/webhooks/payment
