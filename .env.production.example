# =======================================================
# Production .env template (single file for docker-compose)
# =======================================================

############################
# Backend
############################
SPRING_PROFILES_ACTIVE=prod
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
REDIS_URL=redis://:<password>@<host>:6379
JWT_SECRET=replace-with-64-char-random-secret
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
PAYMENT_API_KEY=
WEBHOOK_SECRET=
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASS=re_...
RESEND_API_KEY=re_...

# Active payment provider (Dodo)
DODO_API_KEY=dp_live_...
DODO_WEBHOOK_SECRET=whsec_...
DODO_BASE_URL=https://api.dodopayments.com
DODO_STARTER_PRODUCT_ID=prod_starter_id
DODO_PRO_PRODUCT_ID=prod_pro_id
DODO_ENTERPRISE_PRODUCT_ID=prod_enterprise_id

# Optional Stripe placeholders
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

############################
# Frontend
############################
NEXT_PUBLIC_API_URL=https://api.complianceai.pro/api
NEXT_PUBLIC_APP_URL=https://app.complianceai.pro
NEXT_PUBLIC_WS_URL=wss://api.complianceai.pro/ws
API_BASE_URL=http://backend:8080

# Public payment config
NEXT_PUBLIC_DODO_CLIENT_ID=dodo_client_live_...
NEXT_PUBLIC_DODO_ENV=live
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

############################
# Domain / CORS / URLs
############################
APP_URL=https://app.complianceai.pro
FRONTEND_URL=https://app.complianceai.pro
BACKEND_URL=https://api.complianceai.pro
CORS_ALLOWED_ORIGINS=https://app.complianceai.pro,https://www.complianceai.pro
PAYMENT_WEBHOOK_URL=https://api.complianceai.pro/api/webhooks/payment
