# Backend production environment
SPRING_PROFILES_ACTIVE=prod

# Core infra
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
REDIS_URL=redis://:<password>@<host>:6379

# Auth
JWT_SECRET=replace-with-64-char-random-secret
JWT_EXPIRATION=86400000
APP_AUTH_COOKIES_SECURE=true
APP_BACKUP_ENABLED=false
APP_BACKUP_PROVIDER=
APP_BACKUP_LAST_RESTORE_DRILL_AT=
APP_OPS_ALERT_EMAIL=ops@example.com

# AI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Payments (Dodo)
DODO_API_KEY=dp_live_...
DODO_WEBHOOK_SECRET=whsec_...
DODO_BASE_URL=https://api.dodopayments.com
DODO_GROWTH_PRODUCT_ID=prod_growth_id
DODO_PRO_PRODUCT_ID=prod_pro_id
DODO_AGENCY_PRODUCT_ID=prod_agency_id
DODO_SETUP_PACKAGE_PRODUCT_ID=prod_setup_package_id

# Generic aliases
PAYMENT_API_KEY=
WEBHOOK_SECRET=

# Email
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASS=re_...
RESEND_API_KEY=re_...

# URLs / CORS
APP_URL=https://app.zenvyra.com
FRONTEND_URL=https://app.zenvyra.com
CORS_ALLOWED_ORIGINS=https://app.zenvyra.com,https://www.zenvyra.com
