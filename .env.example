# ==============================
# Production Env
# Copy this file to `.env` and fill all values before launch.
#
# Every key below MUST be referenced by a binding in
# `backend/src/main/resources/application.yml` (or an active profile
# override). The backend reads these via Spring's relaxed binding:
#
#   JWT_SECRET                  -> app.jwt.secret
#   JWT_EXPIRATION              -> app.jwt.expiration
#   JWT_REFRESH_EXPIRATION      -> app.jwt.refresh-expiration
#   JWT_PASSWORD_RESET_EXPIRATION -> app.jwt.password-reset-expiration
#   APP_SECURITY_HSTS_ENABLED   -> app.security.hsts-enabled
#   MONGODB_URI                 -> spring.data.mongodb.uri
#   REDIS_URL                   -> spring.data.redis.url
#   DODO_API_KEY                -> dodo.api-key
#   DODO_WEBHOOK_SECRET         -> dodo.webhook-secret
#   DODO_BASE_URL               -> dodo.base-url
#   DODO_GROWTH_PRODUCT_ID      -> dodo.products.growth
#   DODO_PRO_PRODUCT_ID         -> dodo.products.pro
#   DODO_AGENCY_PRODUCT_ID      -> dodo.products.agency
#   CORS_ALLOWED_ORIGINS        -> cors.allowed-origins
# ==============================

# ---- App URLs ----
APP_URL=https://app.zenvyra.com
FRONTEND_URL=https://app.zenvyra.com
BACKEND_URL=https://api.zenvyra.com
NEXT_PUBLIC_APP_URL=https://app.zenvyra.com
NEXT_PUBLIC_API_URL=https://api.zenvyra.com/api
# CORS_ALLOWED_ORIGINS is a comma-separated list. Wildcards are rejected
# in non-dev profiles (see CorsOriginGuard).
CORS_ALLOWED_ORIGINS=https://app.zenvyra.com,https://www.zenvyra.com

# ---- Runtime ----
SPRING_PROFILES_ACTIVE=prod
NODE_ENV=production

# ---- Databases / Cache ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
REDIS_URL=redis://:<password>@<host>:6379

# ---- Auth / Security ----
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_PASSWORD_RESET_EXPIRATION=3600000
APP_SECURITY_HSTS_ENABLED=true

# ---- Dodo Payments (active integration) ----
# Plan tier values: growth, pro, agency (no STARTER, no ENTERPRISE).
# Legacy "starter" maps to growth; legacy "enterprise" maps to agency.
DODO_API_KEY=dp_live_...
DODO_WEBHOOK_SECRET=whsec_...
DODO_BASE_URL=https://api.dodopayments.com
DODO_GROWTH_PRODUCT_ID=prod_growth_id
DODO_PRO_PRODUCT_ID=prod_pro_id
DODO_AGENCY_PRODUCT_ID=prod_agency_id
NEXT_PUBLIC_DODO_CLIENT_ID=dodo_client_live_...
NEXT_PUBLIC_DODO_ENV=live

# ---- Generic payment aliases (optional wrappers) ----
PAYMENT_API_KEY=
WEBHOOK_SECRET=

# ---- Optional Stripe placeholders (if migrating) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Email (SMTP or Resend SMTP) ----
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASS=re_...
RESEND_API_KEY=re_...

# ---- Webhooks ----
PAYMENT_WEBHOOK_URL=https://api.zenvyra.com/api/webhooks/payment

# ---- Sentry (optional — only reports when DSN is configured) ----
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
