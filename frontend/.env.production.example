# Frontend production environment
NODE_ENV=production
Zenvyra_REQUIRE_PROD_ENV=true

# Public URLs
NEXT_PUBLIC_APP_URL=https://app.zenvyra.com
NEXT_PUBLIC_API_URL=https://api.zenvyra.com/api
NEXT_PUBLIC_WS_URL=wss://api.zenvyra.com/api/ws

# Internal server-side API base (for Next rewrites in container network)
API_BASE_URL=http://backend:8080/api
POLICY_FRAME_ANCESTORS='self' https://app.zenvyra.com

# Payment public config (Dodo)
NEXT_PUBLIC_DODO_CLIENT_ID=dodo_client_live_...
NEXT_PUBLIC_DODO_ENV=live
